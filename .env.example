DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# 32+ random bytes. REQUIRED in production — the app refuses to boot without it.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true ONLY when the app sits behind a reverse proxy/CDN that sets
# x-forwarded-for. Forwarded headers are client-controlled: trusting them blindly
# lets an attacker rotate the header and get a fresh rate-limit bucket on every
# request, which defeats every limiter (login brute-force included). When unset,
# forwarded headers are ignored and all clients share one bucket.
# TRUST_PROXY=false
# Number of trusted proxies appending to x-forwarded-for (default 1). The client
# key is read from the RIGHT of the chain, where entries cannot be forged.
# TRUST_PROXY_HOPS=1

# Comma-separated subset of: cod,bank_transfer,card,gift_card
# Defaults to "cod,bank_transfer,gift_card". `card` stays out until a real
# payment integration exists — the server rejects it regardless of this list.
# PAYMENT_METHODS_ENABLED=cod,bank_transfer,gift_card

# Seed script only (npm run db:seed). Defaults shown are development-only;
# they are refused when NODE_ENV=production.
# SEED_ADMIN_PASSWORD=
# SEED_SUPPORT_PASSWORD=
# SEED_CLIENT_PASSWORD=

# Escape hatch for `npm run db:seed` against a production database.
# The seed TRUNCATEs every table; without this it aborts when NODE_ENV=production.
# ALLOW_DESTRUCTIVE_SEED=1
